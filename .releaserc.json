{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": "beta"
    }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm pkg set version=${nextRelease.version} --prefix apps/extension && bun run zip && bun run zip:firefox && if [ \"${branch.type}\" = prerelease ]; then git checkout HEAD -- apps/extension/package.json CHANGELOG.md; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "apps/extension/package.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "apps/extension/.output/*.zip"
          }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "scripts/release/submit-chrome-web-store.sh ${nextRelease.version}"
      }
    ]
  ]
}
