{
  "name": "open-browser-translate-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=open-browser-translate",
    "dev:firefox": "turbo run dev:firefox --filter=open-browser-translate",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox",
    "build:safari": "turbo run build:safari",
    "zip": "turbo run zip",
    "zip:firefox": "turbo run zip:firefox",
    "site": "turbo run dev --filter=open-browser-translate-site",
    "compile": "turbo run compile",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^9",
    "semantic-release": "^25.0.9",
    "turbo": "^2.11.7"
  }
}
